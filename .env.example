# Roufouf — environment variables
# Copy to .env.local for development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Directus (headless CMS)
# -----------------------------------------------------------------------------
# URL of local Directus (Docker). Leave DIRECTUS_URL empty to force mock mode.
DIRECTUS_URL=http://localhost:8055
# Filled by `pnpm seed` (printed at the end of the script).
DIRECTUS_TOKEN=replace-with-seeded-public-token

# -----------------------------------------------------------------------------
# Meilisearch
# -----------------------------------------------------------------------------
# Local Meilisearch (Docker). Leave empty to use in-memory fallback.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=roufouf-dev-master-key

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# The canonical public URL (used in OpenGraph, sitemap, citations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Duplicate detection
# -----------------------------------------------------------------------------
# Similarity threshold between 0 and 1. The default 0.85 is strict enough to
# avoid false positives while still catching minor edits + metadata changes.
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Server-side caps (used by /api/submissions):
MAX_UPLOAD_MB=50
MAX_BULK_FILES=20
# Client-side caps (must be prefixed NEXT_PUBLIC_ to reach the browser bundle).
# Keep these in sync with the server caps above.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
NEXT_PUBLIC_MAX_BULK_FILES=20

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# "disabled" routes donation submissions into the donation_leads collection so
# interest is captured without charging anything. Switch to a real provider
# (stripe / paymee / konnect / flouci) once legal + banking is settled.
PAYMENT_PROVIDER=disabled

# Uncomment and fill the keys for the provider you enable:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMEE_API_KEY=
# KONNECT_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=10
# Optional — use Upstash Redis for distributed limits when deploying:
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# -----------------------------------------------------------------------------
# Privacy-respecting analytics (optional)
# -----------------------------------------------------------------------------
# Set both to enable (e.g. self-hosted Plausible):
# NEXT_PUBLIC_ANALYTICS_DOMAIN=roufouf.tn
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.example.com/js/script.js
