# Roufouf — environment variables
# Copy to .env.local for development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Directus (headless CMS)
# -----------------------------------------------------------------------------
# URL of local Directus (Docker). Leave DIRECTUS_URL empty to force mock mode.
DIRECTUS_URL=http://localhost:8055
# Filled by `pnpm seed` (printed at the end of the script).
DIRECTUS_TOKEN=replace-with-seeded-public-token
# Static token or session token for an admin-capable Directus user. Used only
# server-side by /api/admin/publish-branding and /api/admin/revert-branding
# so those routes can PATCH the branding_settings singleton.
# DIRECTUS_ADMIN_TOKEN=

# Optional override for branding webhooks. If unset, the site reads
# **Branding webhook secret** from Directus → Ops Settings (editable in the CMS).
# Send as header `x-branding-secret: <value>` or `Authorization: Bearer <value>`.
# BRANDING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Meilisearch
# -----------------------------------------------------------------------------
# Local Meilisearch (Docker). Leave empty to use in-memory fallback.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=roufouf-dev-master-key

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# The canonical public URL (used in OpenGraph, sitemap, citations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override branding Flow default when running `pnpm seed` (fallback is
# NEXT_PUBLIC_SITE_URL). Stored in Directus Ops Settings → branding_site_base_url.
# BRANDING_SITE_BASE_URL=
# Fallback default for Ops Settings -> public_pdf_source when Directus is absent.
# Use `directus` for safe local mode or `zenodo` after the Zenodo workflow is live.
PUBLIC_PDF_SOURCE=directus

# -----------------------------------------------------------------------------
# Zenodo (optional public archive/storage)
# -----------------------------------------------------------------------------
# Use https://sandbox.zenodo.org/api while testing. Production default is
# https://zenodo.org/api when this variable is omitted.
# ZENODO_API_BASE_URL=https://sandbox.zenodo.org/api
# Matching web origin for constructed record/file URLs; inferred from
# ZENODO_API_BASE_URL when omitted.
# ZENODO_WEB_BASE_URL=https://sandbox.zenodo.org
# Server-side organizational-account token with deposit:write + deposit:actions.
# ZENODO_ACCESS_TOKEN=
# Optional Zenodo community identifier and license id for deposits.
# ZENODO_COMMUNITY=
# ZENODO_DEFAULT_LICENSE=cc-by-4.0

# -----------------------------------------------------------------------------
# Duplicate detection
# -----------------------------------------------------------------------------
# Similarity threshold between 0 and 1. The default 0.85 is strict enough to
# avoid false positives while still catching minor edits + metadata changes.
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Server-side caps (used by /api/submissions):
MAX_UPLOAD_MB=50
MAX_BULK_FILES=20
# Client-side caps (must be prefixed NEXT_PUBLIC_ to reach the browser bundle).
# Keep these in sync with the server caps above.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
NEXT_PUBLIC_MAX_BULK_FILES=20

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# "disabled" routes donation submissions into the donation_leads collection so
# interest is captured without charging anything. Switch to a real provider
# (stripe / paymee / konnect / flouci) once legal + banking is settled.
PAYMENT_PROVIDER=disabled

# Uncomment and fill the keys for the provider you enable:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMEE_API_KEY=
# KONNECT_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=10
# Optional — use Upstash Redis for distributed limits when deploying:
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# -----------------------------------------------------------------------------
# Privacy-respecting analytics (optional)
# -----------------------------------------------------------------------------
# Set both to enable (e.g. self-hosted Plausible):
# NEXT_PUBLIC_ANALYTICS_DOMAIN=roufouf.tn
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.example.com/js/script.js

# -----------------------------------------------------------------------------
# Email notifications (optional)
# -----------------------------------------------------------------------------
# These are fallback defaults. Admins can override toggles/recipients in
# Directus -> Ops Settings.
NOTIFICATIONS_ENABLED=false
NOTIFY_CONTACT_ENABLED=true
NOTIFY_SUGGESTIONS_ENABLED=true
NOTIFY_SUBMISSIONS_ENABLED=true
# SMTP transport (required only when NOTIFICATIONS_ENABLED=true)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_FROM_EMAIL=alerts@roufouf.tn
# NOTIFY_TO_EMAIL=ops@roufouf.tn

# -----------------------------------------------------------------------------
# Docker Compose: pdf-worker (PDF optimization queue)
# -----------------------------------------------------------------------------
# The `pdf-worker` service reads DIRECTUS_TOKEN from the Compose environment:
# grant the token’s user PATCH on `documents` and POST on `files` (e.g. a
# service user or admin static token—not the scoped public-read token alone).
# Optional sweep interval override (milliseconds, minimum 30000 enforced in worker code):
# PDF_OPTIMIZE_SWEEP_MS=120000

# -----------------------------------------------------------------------------
# Backup scheduler (docker-compose backup service)
# -----------------------------------------------------------------------------
# These are fallback defaults. Admins can override in Directus -> Ops Settings.
BACKUP_ENABLED=false
BACKUP_POLL_SECONDS=300
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Optional off-site copy to S3-compatible storage
BACKUP_S3_ENABLED=false
# BACKUP_S3_BUCKET=roufouf-backups
BACKUP_S3_PREFIX=roufouf
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
