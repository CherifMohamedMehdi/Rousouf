{
  "name": "roufouf",
  "version": "0.1.0",
  "private": true,
  "description": "Roufouf — The civic knowledge archive",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:writes": "tsx scripts/check-write-flows.ts",
    "stack:up": "docker compose -f ../../docker-compose.yml up -d",
    "stack:down": "docker compose -f ../../docker-compose.yml down",
    "stack:reset": "docker compose -f ../../docker-compose.yml down -v && pnpm stack:up",
    "seed": "tsx scripts/seed.ts",
    "try": "pnpm stack:up && pnpm seed && pnpm dev",
    "worker:pdf": "node ../../workers/pdf-optimize/index.cjs"
  },
  "dependencies": {
    "@directus/sdk": "^17.0.0",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "meilisearch": "^0.42.0",
    "next": "16.2.0",
    "next-intl": "^4.11.0",
    "nodemailer": "^8.0.6",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2"
  }
}
