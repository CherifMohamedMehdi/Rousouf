{
  "name": "roufouf-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter roufouf dev",
    "build": "pnpm --filter roufouf build",
    "start": "pnpm --filter roufouf start",
    "lint": "pnpm --filter roufouf lint",
    "typecheck": "pnpm --filter roufouf typecheck",
    "seed": "pnpm --filter roufouf seed",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && docker compose up -d",
    "worker:pdf": "pnpm --filter pdf-optimize-worker start"
  },
  "devDependencies": {
    "next": "16.2.0"
  }
}
