{
  "name": "roufouf",
  "version": "0.1.0",
  "private": true,
  "description": "Roufouf — The civic knowledge archive",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:writes": "tsx scripts/check-write-flows.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && pnpm stack:up",
    "seed": "tsx scripts/seed.ts",
    "try": "pnpm stack:up && pnpm seed && pnpm dev"
  },
  "dependencies": {
    "@directus/sdk": "^17.0.0",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "meilisearch": "^0.42.0",
    "next": "14.2.18",
    "next-intl": "^3.20.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2"
  }
}
